    "MaximumRequestAttempts": 4,
    "UsedWeightSoftLimit": 1800,
    "RequiredHistoryDays": 90,
    "MaximumClockSkewSeconds": 30
  },
  "TwelveData": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://api.twelvedata.com",
    "Adjustment": "all",
    "MinimumRequestIntervalMilliseconds": 8000,
    "MaximumRequestAttempts": 4,
    "HistoryStart": "2013-01-01"
  },
  "Models": {
    "Root": "artifacts/models"
  },
  "Gdelt": {
    "BaseUrl": "https://api.gdeltproject.org",
    "Enabled": true,
    "MaxRecordsPerAsset": 10,
    "MinimumRequestIntervalMilliseconds": 2500,
    "MaximumRequestAttempts": 4,
    "RetryBaseDelaySeconds": 15,
    "QueryTimespan": "1d"
  },
  "FinnhubNews": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://finnhub.io/api/v1/",
    "LookbackDays": 2,
    "MinimumRequestIntervalMilliseconds": 1100,
    "MaximumRequestAttempts": 3,
    "MaxCryptoArticles": 30
  },
  "MacroNews": {
    "Enabled": true,
