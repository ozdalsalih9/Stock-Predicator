    "PromptVersion": "probora-explanation-v1",
    "MaxPredictionsPerRun": 4,
    "NewsLookbackHours": 72,
    "MaxNewsArticles": 8,
    "RetryFailedAfterHours": 6
  },
  "Serilog": {
    "MinimumLevel": {
