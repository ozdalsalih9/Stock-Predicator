  "Binance": {
    "RestBaseUrl": "https://data-api.binance.vision",
    "WebSocketBaseUrl": "wss://stream.binance.com:9443",
    "BackfillLimit": 1000,
    "BackfillDays": 410,
    "BackfillPageDelayMilliseconds": 100,
